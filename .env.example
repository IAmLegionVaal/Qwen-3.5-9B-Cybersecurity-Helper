# EXAMPLE ONLY. Copy to a local .env file, replace values locally, NEVER commit it.
# A blank value means disabled / unconfigured.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL_ID=
GEMINI_API_KEY=
GITHUB_TOKEN=
WORDPRESS_API_TOKEN=
# API keys should be stored in an OS secret store when possible.
# .env is excluded by .gitignore; never echo these values in logs.
